# Variables PÚBLICAS del sitio (van al navegador). En GitHub: Settings → Secrets and variables → Actions → Variables.
# Endpoint de la Edge Function de registro. Sin esta variable el formulario no envía (en dev simula respuestas).
PUBLIC_REGISTER_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/register
# Solo para el panel /registros (supabase-js).
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Opcional: activa Cloudflare Turnstile en el formulario.
PUBLIC_TURNSTILE_SITE_KEY=
# Opcional: muestra el aviso "registro aún no habilitado" también en producción.
PUBLIC_SHOW_SETUP_NOTICE=false

# Build: dónde vive el sitio. GitHub Pages del repo = https://publifix.github.io + /ubeenet
SITE_URL=https://publifix.github.io
BASE_PATH=/ubeenet
