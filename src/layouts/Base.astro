---
import '../styles/global.css';
import fontUrl from '../assets/fonts/hanken-latin.woff2?url';
import titleFontUrl from '../assets/fonts/roboto-latin.woff2?url';
import { event } from '../config/event';
import { withBase, absoluteUrl } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title = event.meta.title,
  description = event.meta.description,
  path = '',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('og-image.jpg');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#0D1320" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleFontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${event.name} · ${event.dateLong} · ${event.venue.name}, ${event.venue.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
