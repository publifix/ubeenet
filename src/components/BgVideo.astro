---
import { withBase } from '../lib/paths';

const poster = withBase('media/bg-poster.jpg');
const sources = {
  desktop: { webm: withBase('media/bg-loop.webm'), mp4: withBase('media/bg-loop.mp4') },
  mobile: { webm: withBase('media/bg-loop-mobile.webm'), mp4: withBase('media/bg-loop-mobile.mp4') },
  posterMobile: withBase('media/bg-poster-mobile.jpg'),
};
---

<div class="bg" aria-hidden="true">
  <picture>
    <source media="(max-width: 767px)" srcset={sources.posterMobile} />
    <img class="bg__media" src={poster} alt="" width="1920" height="1080" fetchpriority="low" decoding="async" />
  </picture>
  <video class="bg__media bg__video" muted loop playsinline preload="none" data-sources={JSON.stringify(sources)}
  ></video>
  <div class="bg__overlay"></div>
</div>

<style>
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--noche);
    pointer-events: none;
  }
  .bg__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bg__video {
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .bg__video[data-playing] {
    opacity: 1;
  }
  /* Legibilidad del texto a la izquierda; la nube de la derecha queda limpia. */
  .bg__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(13, 19, 32, 0) calc(100% - 160px), var(--noche) 100%),
      linear-gradient(90deg, rgba(13, 19, 32, 0.78) 0%, rgba(13, 19, 32, 0.4) 38%, rgba(13, 19, 32, 0) 62%);
  }
  @media (max-width: 767px) {
    .bg__overlay {
      background: linear-gradient(180deg, rgba(13, 19, 32, 0.6) 0%, rgba(13, 19, 32, 0.62) 55%, rgba(13, 19, 32, 0.15) 80%, var(--noche) 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bg__video {
      display: none;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.bg__video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (video && !reduce.matches && !saveData) {
    const sources = JSON.parse(video.dataset.sources || '{}');
    const set = window.matchMedia('(max-width: 767px)').matches ? sources.mobile : sources.desktop;
    const canWebm = video.canPlayType('video/webm; codecs="vp9"') !== '';
    video.src = canWebm ? set.webm : set.mp4;
    video.addEventListener('playing', () => video.setAttribute('data-playing', ''), { once: true });

    // Pausa cuando el hero sale de pantalla.
    const hero = video.closest('section') ?? video;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(hero);
  }
</script>
