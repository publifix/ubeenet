---
import { event } from '../config/event';
import BgVideo from './BgVideo.astro';

const [startLabel, endLabel] = event.timeRange.split(' a ');
---

<section class="hero" aria-labelledby="hero-title">
  <BgVideo />
  <div class="container hero__inner">
    <h1 class="display hero__title" id="hero-title">{event.hero.title}</h1>
    <p class="lead hero__subtitle">{event.hero.subtitle}</p>
    <dl class="hero__data data">
      <div>
        <dt>Fecha</dt>
        <dd><time datetime={event.startLocalIso.slice(0, 10)}>{event.dateLong}</time></dd>
      </div>
      <div>
        <dt>Horario</dt>
        <dd>
          <time datetime={event.startLocalIso}>{startLabel}</time> a <time datetime={event.endLocalIso}>{endLabel}</time>
        </dd>
      </div>
      <div>
        <dt>Sede</dt>
        <dd><a href="#sede">{event.venue.name}, {event.venue.city}</a></dd>
      </div>
    </dl>
    <a class="btn btn-primary hero__cta" href="#registro">{event.hero.cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(80px + var(--s-6)) var(--s-12);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__title {
    max-width: 10ch;
  }
  .hero__subtitle {
    margin-top: var(--s-3);
    max-width: 30ch;
  }
  .hero__data {
    margin-top: var(--s-6);
    max-width: 30rem;
    border-top: 1px solid var(--linea);
  }
  .hero__data > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--s-2);
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px solid var(--linea);
  }
  .hero__data dt {
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--texto-suave);
  }
  .hero__data dd {
    margin: 0;
  }
  .hero__data a {
    color: inherit;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .hero__data a:hover {
    color: var(--texto);
    text-decoration-color: currentColor;
  }
  .hero__cta {
    margin-top: var(--s-6);
    min-width: 13rem;
  }

  /* Secuencia de carga: H1 → datos → botón (600 ms en total). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__subtitle,
    .hero__data,
    .hero__cta {
      animation: rise 360ms var(--ease-out) both;
    }
    .hero__subtitle {
      animation-delay: 60ms;
    }
    .hero__data {
      animation-delay: 120ms;
    }
    .hero__cta {
      animation-delay: 240ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 767px) {
    .hero {
      align-items: flex-start;
      padding-block: calc(72px + var(--s-4)) var(--s-8);
    }
    .hero__data {
      margin-top: var(--s-4);
    }
    .hero__data > div {
      grid-template-columns: 4.5rem 1fr;
    }
    .hero__cta {
      width: 100%;
      margin-top: var(--s-4);
    }
  }
</style>
