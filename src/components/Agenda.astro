---
import { event } from '../config/event';
const date = event.startLocalIso.slice(0, 10);
---

<section class="section" aria-labelledby="agenda-titulo">
  <div class="container split">
    <div class="split__head">
      <h2 id="agenda-titulo">{event.agenda.title}</h2>
      <p class="agenda__date data">{event.dateLong}</p>
    </div>
    <ol class="timeline">
      {
        event.agenda.items.map((item) => (
          <li class="timeline__item">
            <time class="timeline__time data" datetime={`${date}T${item.iso}-06:00`}>
              {item.time}
            </time>
            <svg class="timeline__node" viewBox="0 0 20 22" aria-hidden="true">
              <path d="M10 1 18.66 6v10L10 21l-8.66-5V6Z" />
            </svg>
            <span class="timeline__title">{item.title}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .agenda__date {
    margin-top: var(--s-2);
    color: var(--texto-suave);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 20px minmax(0, 1fr);
    column-gap: var(--s-3);
    align-items: center;
    padding-block: 18px;
  }
  .timeline__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(6.5rem + var(--s-3) + 9.5px);
    top: calc(50% + 12px);
    height: calc(100% - 24px);
    width: 1px;
    background: var(--linea);
  }
  .timeline__time {
    color: var(--texto-suave);
    white-space: nowrap;
  }
  .timeline__node {
    width: 20px;
    height: 22px;
    fill: var(--noche);
    stroke: rgba(104, 166, 189, 0.55);
    stroke-width: 1;
  }
  .timeline__title {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.35;
  }
  @media (max-width: 767px) {
    .timeline__item {
      grid-template-columns: 20px minmax(0, 1fr);
      grid-template-areas: 'node time' 'node title';
      column-gap: var(--s-2);
      row-gap: 2px;
      align-items: start;
      padding-block: 14px;
    }
    .timeline__node {
      grid-area: node;
      margin-top: 2px;
    }
    .timeline__time {
      grid-area: time;
      font-size: 0.9375rem;
    }
    .timeline__title {
      grid-area: title;
      font-size: 1.0625rem;
    }
    .timeline__item:not(:last-child)::after {
      left: 9.5px;
      top: calc(14px + 26px);
      height: calc(100% - 26px);
    }
  }
</style>
