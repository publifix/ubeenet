---
import { event } from '../config/event';
import Curve from './Curve.astro';
const date = event.startLocalIso.slice(0, 10);
---

<section class="section agenda" id="agenda" aria-labelledby="agenda-titulo">
  <div class="container split">
    <div class="split__head">
      <h2 id="agenda-titulo">{event.agenda.title}</h2>
      <p class="agenda__date data">{event.dateLong}<br />{event.timeRange}</p>
    </div>
    <div>
      <ol class="rows timeline">
        {
          event.agenda.items.map((item) => (
            <li class="timeline__item">
              <time class="timeline__time data" datetime={`${date}T${item.iso}-06:00`}>
                {item.time}
              </time>
              <div>
                <p class="timeline__title">{item.title}</p>
                {item.detail && <p class="timeline__detail">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="agenda__note">{event.agenda.note}</p>
    </div>
  </div>
  <Curve fill="var(--niebla)" position="bottom" />
</section>

<style>
  .agenda {
    padding-bottom: calc(var(--section-gap) / 2 + var(--curve-h));
  }
  .agenda__date {
    margin-top: var(--s-3);
    color: var(--texto-suave);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--s-3);
    align-items: baseline;
    padding-block: 20px;
  }
  .timeline__time {
    color: var(--texto-suave);
    white-space: nowrap;
  }
  .timeline__title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .timeline__detail {
    margin-top: 4px;
    color: var(--texto-suave);
  }
  .agenda__note {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--texto-suave);
  }
  @media (max-width: 767px) {
    .timeline__item {
      grid-template-columns: 1fr;
      row-gap: 4px;
      padding-block: 16px;
    }
    .timeline__time {
      font-size: 0.9375rem;
    }
    .timeline__title {
      font-size: 1.125rem;
    }
  }
</style>
