---
// Borde curvo entre un bloque y el siguiente. `fill` es el color del bloque que entra.
interface Props {
  fill: string;
  position: 'top' | 'bottom';
  flip?: boolean;
}
const { fill, position, flip = false } = Astro.props;
// Abajo: el bloque claro sube de izquierda a derecha, como en ubeenet.com.
const d =
  position === 'bottom'
    ? 'M0 100 C 35 100 70 80 100 0 L 100 100 Z'
    : 'M0 0 L 100 0 C 65 0 30 20 0 100 Z';
---

<svg
  class={`curve curve--${position}`}
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  style={flip ? 'transform: scaleX(-1)' : undefined}
>
  <path d={d} fill={fill}></path>
</svg>
