---
import { event } from '../config/event';
import Curve from './Curve.astro';
---

<section class="section section--light partners" aria-labelledby="partners-titulo">
  <div class="container split">
    <h2 id="partners-titulo" class="split__head">{event.partners.title}</h2>
    <ul class="partners__list" role="list">
      {event.partners.items.map((name) => <li>{name}</li>)}
    </ul>
  </div>
  <Curve fill="var(--noche)" position="bottom" flip />
</section>

<style>
  .partners {
    padding-top: 0;
    padding-bottom: calc(var(--section-gap) / 2 + var(--curve-h));
  }
  .partners__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--linea-clara);
  }
  .partners__list li {
    padding-block: 18px;
    border-bottom: 1px solid var(--linea-clara);
    font-size: clamp(1.125rem, 0.8vw + 0.95rem, 1.5rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--tinta);
  }
  .partners__list li:nth-child(odd) {
    padding-right: var(--s-3);
  }
  @media (max-width: 479px) {
    .partners__list {
      grid-template-columns: 1fr;
    }
  }
</style>
