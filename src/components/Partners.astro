---
import { event } from '../config/event';
---

<section class="section" aria-labelledby="partners-titulo">
  <div class="container split">
    <h2 id="partners-titulo" class="split__head">{event.partners.title}</h2>
    <ul class="partners" role="list">
      {event.partners.items.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .partners {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    align-items: baseline;
  }
  .partners li {
    font-size: clamp(1.125rem, 1vw + 0.9rem, 1.375rem);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: 0.01em;
    color: var(--acero);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .partners {
      gap: 12px var(--s-4);
    }
  }
</style>
