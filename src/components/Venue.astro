---
import { event } from '../config/event';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
const v = event.venue;
const src = (w: number) => withBase(`media/venue-${w}.webp`);
---

<section class="section section--light venue" id="sede" aria-labelledby="sede-titulo">
  <div class="container venue__grid">
    <div class="venue__copy">
      <h2 id="sede-titulo">{v.name}</h2>
      <address class="venue__address">{v.address}.</address>
      <div class="venue__actions">
        <a class="btn btn-secondary" href={v.mapsUrl} target="_blank" rel="noopener">
          {event.venueSection.mapsLabel}<Icon name="arrow-up-right" />
        </a>
        <a class="btn btn-secondary" href={v.wazeUrl} target="_blank" rel="noopener">
          {event.venueSection.wazeLabel}<Icon name="arrow-up-right" />
        </a>
      </div>
      <p class="venue__note">{v.note}</p>
    </div>
    <figure class="venue__photo">
      <picture>
        <source
          type="image/webp"
          srcset={`${src(800)} 800w, ${src(1280)} 1280w, ${src(1920)} 1920w`}
          sizes="(min-width: 1024px) 58vw, 100vw"
        />
        <img
          src={withBase('media/venue-1280.jpg')}
          alt={event.venueSection.photoAlt}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .venue__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-3);
    row-gap: var(--s-6);
    align-items: center;
  }
  .venue__copy {
    grid-column: 1 / span 5;
    padding-right: var(--s-3);
  }
  .venue__photo {
    grid-column: 6 / -1;
  }
  .venue__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-panel);
  }
  .venue__address {
    margin-top: var(--s-3);
    max-width: 34ch;
    font-style: normal;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--tinta-suave);
  }
  .venue__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--s-4);
  }
  .venue__note {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--tinta-suave);
  }
  @media (max-width: 1023px) {
    .venue__copy,
    .venue__photo {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }
  @media (max-width: 767px) {
    .venue__actions .btn {
      flex: 1 1 100%;
    }
    .venue__photo img {
      aspect-ratio: 4 / 3;
      border-radius: 16px;
    }
  }
</style>
