---
import { withBase } from '../lib/paths';

// Sin menú de secciones: la landing tiene un solo objetivo (registrarse).
// En otras páginas el botón lleva al formulario de la landing.
const { onLanding = true } = Astro.props as { onLanding?: boolean };
const ctaHref = onLanding ? '#registro' : withBase('#registro');
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href={withBase()} aria-label="Ubeenet Connect, inicio">
      <img src={withBase('brand/ubeenet-white.svg')} alt="Ubeenet" width="150" height="25" />
    </a>
    <a class="btn btn-primary site-header__cta" href={ctaHref}>Registrarme</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    transition: background-color 200ms ease, border-color 200ms ease;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: rgba(13, 19, 32, 0.86);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom-color: var(--linea-tenue);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }
  .site-header__logo {
    display: inline-flex;
    padding-block: var(--s-1);
  }
  .site-header__logo img {
    width: clamp(120px, 12vw, 150px);
    height: auto;
  }
  .site-header__cta {
    min-height: 44px;
    padding-inline: 22px;
    font-size: 0.9375rem;
  }
  @media (max-width: 899px) {
    .site-header__inner {
      height: 72px;
    }
  }
  @media (max-width: 767px) {
    .site-header__cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
