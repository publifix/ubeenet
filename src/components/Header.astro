---
import { withBase } from '../lib/paths';

// En otras páginas los enlaces llevan a las secciones de la landing.
const { onLanding = true } = Astro.props as { onLanding?: boolean };
const to = (hash: string) => (onLanding ? hash : withBase(hash));
const nav = [
  { href: to('#sede'), label: 'Sede' },
  { href: to('#preguntas'), label: 'Preguntas' },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href={withBase()} aria-label="Ubeenet Connect, inicio">
      <img src={withBase('brand/ubeenet-white.svg')} alt="Ubeenet" width="150" height="25" />
    </a>
    <nav class="site-header__nav" aria-label="Secciones">
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary site-header__cta" href={to('#registro')}>Registrarme</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    transition: background-color 200ms ease, border-color 200ms ease;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: rgba(13, 19, 32, 0.86);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom-color: var(--linea-tenue);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 80px;
  }
  .site-header__logo {
    display: inline-flex;
    justify-self: start;
    padding-block: var(--s-1);
  }
  .site-header__logo img {
    width: clamp(120px, 12vw, 150px);
    height: auto;
  }
  .site-header__nav ul {
    display: flex;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    display: inline-block;
    padding-block: 10px;
    color: var(--texto);
    font-size: 0.9375rem;
    text-decoration-color: transparent;
  }
  .site-header__nav a:hover {
    color: var(--texto);
    text-decoration-color: currentColor;
  }
  .site-header__cta {
    justify-self: end;
    min-height: 44px;
    padding-inline: 22px;
    font-size: 0.9375rem;
  }
  @media (max-width: 899px) {
    .site-header__nav {
      display: none;
    }
    .site-header__inner {
      grid-template-columns: 1fr auto;
      height: 72px;
    }
  }
  @media (max-width: 767px) {
    .site-header__cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
