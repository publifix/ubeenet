---
import { event } from '../config/event';
---

<section class="section" aria-labelledby="temas-titulo">
  <div class="container split">
    <h2 id="temas-titulo" class="split__head">{event.themes.title}</h2>
    <ul class="rows themes" role="list">
      {
        event.themes.items.map((item) => (
          <li class="themes__item">
            <h3 class="h3">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .themes__item {
    padding-block: var(--s-3) 28px;
  }
  .themes__item p {
    margin-top: var(--s-1);
    color: var(--texto-suave);
  }
</style>
