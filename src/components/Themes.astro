---
import { event } from '../config/event';
---

<section class="section" aria-labelledby="temas-titulo">
  <div class="container split">
    <h2 id="temas-titulo" class="split__head">{event.themes.title}</h2>
    <ol class="route">
      {
        event.themes.items.map((item) => (
          <li class="route__item">
            <h3 class="h3">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .route {
    --gap: var(--s-6);
    --node: 15px;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--s-6);
    display: grid;
    gap: var(--gap);
  }
  .route__item {
    position: relative;
  }
  /* Nodo */
  .route__item::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--s-6));
    top: 4px;
    width: var(--node);
    height: var(--node);
    border: 1px solid rgba(104, 166, 189, 0.7);
    border-radius: var(--r-pill);
    background: radial-gradient(circle, rgba(104, 166, 189, 0.7) 0 2.5px, var(--noche) 3px);
  }
  /* Ruta hasta el siguiente nodo */
  .route__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(-1 * var(--s-6) + (var(--node) - 1px) / 2);
    top: calc(4px + var(--node));
    bottom: calc(-1 * var(--gap) - 4px);
    width: 1px;
    background: rgba(104, 166, 189, 0.45);
  }
  .route__item p {
    margin-top: var(--s-1);
    color: var(--texto-suave);
  }
  @media (max-width: 767px) {
    .route {
      --gap: var(--s-4);
      padding-left: var(--s-4);
    }
    .route__item::before {
      left: calc(-1 * var(--s-4));
    }
    .route__item:not(:last-child)::after {
      left: calc(-1 * var(--s-4) + (var(--node) - 1px) / 2);
    }
  }
</style>
