---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Themes from '../components/Themes.astro';
import Sponsors from '../components/Sponsors.astro';
import Venue from '../components/Venue.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { event } from '../config/event';
import { absoluteUrl } from '../lib/paths';

const v = event.venue;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description: event.meta.description,
  startDate: event.startLocalIso,
  endDate: event.endLocalIso,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: true,
  inLanguage: 'es-MX',
  image: [absoluteUrl('og-image.jpg')],
  url: absoluteUrl(),
  location: {
    '@type': 'Place',
    name: v.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: v.street,
      addressLocality: v.locality,
      addressRegion: v.region,
      postalCode: v.postalCode,
      addressCountry: v.country,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: event.organizer.shortName,
    legalName: event.organizer.name,
    url: event.organizer.url,
    email: event.organizer.email,
  },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'MXN',
    availability: 'https://schema.org/LimitedAvailability',
    url: absoluteUrl() + '#registro',
  },
};
---

<Base jsonLd={jsonLd}>
  <a class="skip-link" href="#registro">Ir al registro</a>
  <Header />
  <main>
    <Hero />
    <Themes />
    <Sponsors />
    <Venue />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyCta />
</Base>

<script>
  // Mantiene activo el proyecto de Supabase (el plan gratuito se pausa tras 7 días sin
  // actividad): una consulta de lectura por visitante y día, cuando el navegador está libre.
  // No envía datos del visitante; con RLS la respuesta es una lista vacía.
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (url && key) {
    const today = new Date().toISOString().slice(0, 10);
    let seen = '';
    try {
      seen = localStorage.getItem('ubeenet-ping') || '';
    } catch {}
    if (seen !== today) {
      const ping = () =>
        fetch(`${url}/rest/v1/registrations?select=id&limit=1`, { headers: { apikey: key, Authorization: `Bearer ${key}` } })
          .then(() => {
            try {
              localStorage.setItem('ubeenet-ping', today);
            } catch {}
          })
          .catch(() => {});
      'requestIdleCallback' in window ? requestIdleCallback(ping, { timeout: 5000 }) : setTimeout(ping, 3000);
    }
  }
</script>
