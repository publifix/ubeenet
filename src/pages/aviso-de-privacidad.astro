---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { event } from '../config/event';
const o = event.organizer;
const p = event.privacy;
// Convierte el correo de contacto del texto en un enlace mailto.
const linkEmail = (t: string) =>
  t.replace(o.email, `<a href="mailto:${o.email}">${o.email}</a>`);
---

<Base title={`${p.title} · ${event.name}`} description={`${p.title} del registro a ${event.nameInSentence}.`} path="aviso-de-privacidad/">
  <Header onLanding={false} />
  <main class="container legal"><div class="legal__body">
    <h1 class="h2">{p.title}</h1>
    <p>{p.intro}</p>

    {
      p.sections.map((sec) => (
        <>
          <h2 class="h3">{sec.title}</h2>
          {sec.text.map((t) => <p set:html={linkEmail(t)} />)}
        </>
      ))
    }

    <h2 class="h3">Contacto</h2>
    <p>
      <a href={`mailto:${o.email}`}>{o.email}</a> · <a href={o.phoneHref}>{o.phone}</a>
    </p>

    <p class="legal__updated">Última actualización: {p.updated}.</p>
  </div></main>
  <Footer />
</Base>

<style>
  .legal {
    padding-block: calc(72px + var(--s-8)) var(--s-12);
  }
  .legal__body {
    max-width: 46rem;
  }
  .legal h2 {
    margin-top: var(--s-6);
  }
  .legal p {
    margin-top: 12px;
    color: var(--texto-suave);
  }
  .legal__updated {
    margin-top: var(--s-6);
    font-size: var(--fs-small);
  }
</style>
