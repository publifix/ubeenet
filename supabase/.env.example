# Secrets de la Edge Function `register` (NUNCA en el repo ni en el frontend).
# Local:      cp supabase/.env.example supabase/.env.local  y llénalo.
# Producción: supabase secrets set --env-file supabase/.env.local
RESEND_API_KEY=
RESEND_FROM=Ubeenet Eventos <eventos@ubeenet.com>
ALLOWED_ORIGINS=https://publifix.github.io,http://localhost:4321
SITE_PUBLIC_URL=https://publifix.github.io/ubeenet
# Opcionales
TURNSTILE_SECRET=
NOTIFY_EMAIL=elia@blanconuclear.com.mx
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya vienen en el entorno de Edge Functions.
