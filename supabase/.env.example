# Secrets de la Edge Function `register` (NUNCA en el repo ni en el frontend).
# Producción: los carga el workflow .github/workflows/supabase.yml desde los
# secrets y variables del repo. Local: cp supabase/.env.example supabase/.env.local
RESEND_API_KEY=
RESEND_FROM=Ubeenet Eventos <eventos@ubeenetevents.com.mx>
REPLY_TO=sales@ubeenet.com
ALLOWED_ORIGINS=https://ubeenetevents.com.mx,https://www.ubeenetevents.com.mx,https://publifix.github.io,http://localhost:4321
SITE_PUBLIC_URL=https://ubeenetevents.com.mx
NOTIFY_EMAIL=elia@blanconuclear.com.mx,labs.publifix@gmail.com,mirna@blanconuclear.com.mx
# Opcional
TURNSTILE_SECRET=
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya vienen en el entorno de Edge Functions.
